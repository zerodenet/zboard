ZBOARD_ENVIRONMENT=production
ZBOARD_MYSQL_ROOT_PASSWORD=generate-a-distinct-root-password
ZBOARD_MYSQL_PASSWORD=generate-a-strong-zboard-db-password
ZBOARD_DATA_SOURCE=zboard:generate-a-strong-zboard-db-password@tcp(mysql:3306)/zboard?charset=utf8mb4&parseTime=true&loc=Local
ZBOARD_REDIS_ADDR=redis:6379
ZBOARD_JWT_SECRET=generate-at-least-32-random-bytes
ZBOARD_CREDENTIAL_ENCRYPTION_KEY=generate-exactly-32-random-bytes-as-base64-or-hex
ZBOARD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ZBOARD_BOOTSTRAP_ADMIN_PASSWORD=generate-at-least-16-random-bytes
ZBOARD_ZERO_ARTIFACT_HOST_DIR=/absolute/path/to/zboard-artifacts
ZBOARD_ZERO_EVENT_SPOOL_MODE=file
ZBOARD_ZERO_EVENT_SPOOL_HOST_DIR=/absolute/path/to/zboard-zero-events
# Keep legacy until the matching local Zero build is packaged and rolled out deliberately.
ZBOARD_ZERO_KERNEL_CONTRACT=legacy
ZBOARD_ZERO_LOCAL_VERSION=
ZBOARD_NODE_ROOT_USER=root
ZBOARD_GOROOT_FALLBACK=C:\Users\higanbana\sdk\golang
ZBOARD_REQUIRED_GO_VERSION=1.26.5
ZBOARD_ALLOW_STALE_GO_VERSION=0
