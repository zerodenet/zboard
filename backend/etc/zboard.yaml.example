Name: zboard
Host: 0.0.0.0
Port: 8080
MaxBytes: 1048576
Timeout: 2000000000
MaxConns: 10000

environment: development
datasource: ""
redis_addr: "redis:6379"
jwt_secret: ""
bootstrap_admin_email: ""
bootstrap_admin_password: ""
credential_encryption_key: ""
zero_artifact_dir: ""
zero_kernel_contract: "legacy"
zero_local_version: ""
zero_event_spool_mode: "file"
zero_event_spool_dir: "/var/lib/zboard/zero-events"
zero_event_spool_compression_algorithm: "zstd"
zero_event_spool_compression_level: 1
zero_event_spool_compression_block_bytes: 2097152
zero_event_spool_compression_workers: 1
zero_event_spool_max_bytes: 5368709120
zero_event_spool_warning_ratio: 0.75
zero_event_spool_compact_ratio: 0.85
zero_event_spool_emergency_ratio: 0.95
zero_event_spool_min_free_bytes: 536870912
zero_event_spool_emergency_reserve_bytes: 268435456
zero_event_spool_critical_reserve_bytes: 1073741824