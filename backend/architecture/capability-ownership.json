    {
      "name": "commerce.payments.record",
      "owner": "commerce",
      "source": "internal/application/commerce_catalog.go",
      "plugin_capability": "",
      "external_http": true,
      "note": "Records a payment fact verified by an external integration; checkout, callbacks, signatures, and provider SDKs remain outside ZBoard."
    }
  ],
  "cross_domain_transactions": [
    {
      "id": "commerce.payment_fact_settlement",
      "owner": "commerce",
      "source": "internal/adapters/persistence/commercestore/payment_facts.go",
      "symbol": "PaymentFacts.Record",
      "participants": ["commerce", "entitlements", "resources", "observability"],
      "atomicity": "single_database_transaction",
      "compensation": "Rollback the payment event, order transition, entitlement grant, audit row, and publication intent together; provider_event_id makes replay conflict-safe.",
      "outbox": "NodeConfigPublish intents are inserted in the settlement transaction only when fulfillment changes the subscription."
    },
    {
      "id": "commerce.admin_order_settlement",
      "owner": "commerce",
      "source": "internal/adapters/persistence/commercestore/order_settlement.go",
      "symbol": "OrderSettlement.Apply",
      "participants": ["commerce", "entitlements", "resources", "observability"],
      "atomicity": "single_database_transaction",
      "compensation": "Rollback order transition, entitlement fulfillment, audit row, and publication intent together; repeated paid settlement is idempotent.",
      "outbox": "NodeConfigPublish intents are committed with a newly fulfilled subscription."
    },
    {
      "id": "metering.flow_completion",
      "owner": "metering",
      "source": "internal/adapters/persistence/meteringstore/completion.go",
      "symbol": "CompletionAccounting.Complete",
      "participants": ["metering", "entitlements", "resources"],
      "atomicity": "single_database_transaction",
      "compensation": "Rollback traffic, usage cursor, quota deduction, credential expiry, and publication intents together; node_id plus report_id deduplicates replay.",
      "outbox": "When quota is exhausted, NodeConfigPublish intents are inserted before commit and delivered asynchronously."
    },
    {
      "id": "entitlements.quota_execution",
      "owner": "entitlements",
      "source": "internal/adapters/persistence/entitlementstore/quota_execution.go",
      "symbol": "QuotaExecution.Execute",
      "participants": ["jobs", "entitlements", "resources"],
      "atomicity": "single_database_transaction",
      "compensation": "Rollback quota, quota event, and publication intent together; the task_item reference prevents a replay from applying the adjustment twice.",
      "outbox": "NodeConfigPublish intents are committed with the quota adjustment."
    },
    {
      "id": "entitlements.subscription_mutation",
      "owner": "entitlements",
      "source": "internal/adapters/persistence/entitlementstore/subscription_mutations.go",
      "symbol": "SubscriptionMutations.Apply",
      "participants": ["entitlements", "resources", "observability"],
      "atomicity": "single_database_transaction",
      "compensation": "Rollback subscription state, credential change, publication intent, mutation receipt and audit together; a unique idempotency key returns the same receipt for identical replay.",
      "outbox": "NodeConfigPublish intents are committed with the subscription change."
    },
    {
      "id": "entitlements.credential_expiry",
      "owner": "entitlements",
      "source": "internal/adapters/persistence/entitlementstore/credential_expiry.go",
      "symbol": "CredentialExpiry.ExpireDueCredentials",
      "participants": ["entitlements", "resources"],
      "atomicity": "single_database_transaction",
      "compensation": "Rollback subscription and credential expiry with publication intents; the next bounded scan retries uncommitted rows.",
      "outbox": "One coalesced NodeConfigPublish intent is inserted per affected node before credentials become expired."
    },
    {
      "id": "identity.local_registration_message",
      "owner": "identity",
      "source": "internal/adapters/persistence/identitystore/registration.go",
      "symbol": "registrationTx.CreateLocalAccount",
      "participants": ["identity", "messaging"],
      "atomicity": "joins_registration_transaction",
      "compensation": "Account creation and handoff event roll back together; the messaging consumer retries the unprocessed event.",
      "outbox": "AccountRegistrationEvent is the durable identity-owned message handoff and carries no message body or credential."
    },
    {
      "id": "identity.external_registration_message",
      "owner": "identity",
      "source": "internal/adapters/persistence/identitystore/external.go",
      "symbol": "externalTx.CreateExternalAccount",
      "participants": ["identity", "messaging"],
      "atomicity": "joins_external_identity_transaction",
      "compensation": "External account creation and handoff event roll back together; the messaging consumer retries the unprocessed event.",
      "outbox": "AccountRegistrationEvent is committed in the same transaction as the external account."
    },
    {
      "id": "resources.node_publication_intent",
      "owner": "resources",
      "source": "internal/adapters/persistence/networkstore/publication_intents.go",
      "symbol": "EnqueuePublication",
      "participants": ["resources", "jobs", "network"],
      "atomicity": "joins_calling_domain_transaction",
      "compensation": "The calling transaction rolls back the intent; committed failures retain the row for leased retry while newer requests coalesce by generation.",
      "outbox": "NodeConfigPublish is the durable outbox record; the shared jobs runtime leases and delivers it to the Zero adapter."
    }
  ]
}
