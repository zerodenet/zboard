# Compose identity and the exact image produced by .github/workflows/release.yml.
COMPOSE_PROJECT_NAME=zboard
ZBOARD_IMAGE_REPOSITORY=ghcr.io/zerodenet/zboard
ZBOARD_IMAGE_TAG=v0.0.1-dev.3

# Use "always" for an online registry deployment. Use "missing" after loading
# the attached release image archive with: docker load < zboard_*-image.tar.gz
ZBOARD_PULL_POLICY=always

# Bind to 127.0.0.1 when a reverse proxy terminates public HTTP/TLS.
# Change to 0.0.0.0 only when direct network exposure is intentional.
ZBOARD_HTTP_BIND=127.0.0.1
ZBOARD_HTTP_PORT=8080

# Existing infrastructure. Compose starts only Zboard and joins this external
# Docker network; it never creates or owns MySQL or Redis.
ZBOARD_EXTERNAL_NETWORK=existing_backend
ZBOARD_DATA_SOURCE=
ZBOARD_REDIS_ADDR=redis:6379
ZBOARD_REDIS_PASSWORD=

# Required application secrets. Leave these empty until they have been
# replaced; Compose deliberately refuses to start while required values are
# empty.
# Generate URL-safe hexadecimal values, for example:
#   openssl rand -hex 32
ZBOARD_JWT_SECRET=
ZBOARD_CREDENTIAL_ENCRYPTION_KEY=

# Optional first-start bootstrap administrator. Leave both empty to use /setup.
# If one is set, both are required; the production password minimum is 16 bytes.
# Existing administrator accounts are never overwritten.
ZBOARD_BOOTSTRAP_ADMIN_EMAIL=
ZBOARD_BOOTSTRAP_ADMIN_PASSWORD=

# This directory must exist on the Docker host. It contains trusted Zero musl
# artifacts and their checksum files and is mounted read-only into Zboard.
ZBOARD_ZERO_ARTIFACT_HOST_DIR=./artifacts

# "legacy" is the safe published-kernel contract.
ZBOARD_ZERO_KERNEL_CONTRACT=legacy
ZBOARD_ZERO_LOCAL_VERSION=

# Native-local example (enable only when the exact trusted artifact is present):
# ZBOARD_ZERO_KERNEL_CONTRACT=native-local
# ZBOARD_ZERO_LOCAL_VERSION=0.0.15-rc.1

# Use this only after a reviewed local Zero artifact implements the Mieru
# principal contract. Current public Zero releases do not provide it.
# ZBOARD_ZERO_KERNEL_CONTRACT=native-local-mieru
