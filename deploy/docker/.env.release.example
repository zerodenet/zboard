# Compose identity and the exact image produced by .github/workflows/release.yml.
COMPOSE_PROJECT_NAME=zboard
ZBOARD_IMAGE_REPOSITORY=ghcr.io/zerodenet/zboard
ZBOARD_IMAGE_TAG=v0.0.1-dev.3

# Use "always" for an online registry deployment. Use "missing" after loading
# the attached release image archive with: docker load < zboard_*-image.tar.gz
ZBOARD_PULL_POLICY=always

# Bind to 127.0.0.1 when a reverse proxy terminates public HTTP/TLS.
# Change to 0.0.0.0 only when direct network exposure is intentional.
ZBOARD_HTTP_BIND=127.0.0.1
ZBOARD_HTTP_PORT=8080

# Existing infrastructure. Compose starts only Zboard and joins this external
# Docker network; it never creates or owns MySQL or Redis.
ZBOARD_EXTERNAL_NETWORK=existing_backend
ZBOARD_DATA_SOURCE=
ZBOARD_DATABASE_DRIVER=mysql
# SQLite only: use docker-compose.sqlite.yml, set ZBOARD_DATA_SOURCE to
# /var/lib/zboard/data/zboard.db, and uncomment the host directory below.
# ZBOARD_DATABASE_HOST_DIR=./data
ZBOARD_DATABASE_MAX_OPEN_CONNECTIONS=8
ZBOARD_DATABASE_MAX_IDLE_CONNECTIONS=2
ZBOARD_DATABASE_CONNECTION_MAX_LIFETIME_SECONDS=3600

# Required application secrets. Leave these empty until they have been
# replaced; Compose deliberately refuses to start while required values are
# empty.
# Generate URL-safe hexadecimal values, for example:
#   openssl rand -hex 32
ZBOARD_JWT_SECRET=
ZBOARD_CREDENTIAL_ENCRYPTION_KEY=

# Optional first-start bootstrap administrator. Leave both empty to use /setup.
# If one is set, both are required; the production password minimum is 16 bytes.
# Existing administrator accounts are never overwritten.
ZBOARD_BOOTSTRAP_ADMIN_EMAIL=
ZBOARD_BOOTSTRAP_ADMIN_PASSWORD=

# Trusted Zero musl artifacts and checksum files. This directory remains
# read-only inside Zboard. prepare-host-dirs.sh also creates its empty rules/
# mount point so the writable child bind can be attached safely.
ZBOARD_ZERO_ARTIFACT_HOST_DIR=./artifacts

# Canonical managed-rule sources and compiled ZRS artifacts. This directory is
# writable, persistent, shared by blue/green instances, and must be backed up
# together with the database.
ZBOARD_MANAGED_RULE_HOST_DIR=./managed-rules

# Durable high-frequency Zero event spool. "file" is the default; set
# ZBOARD_ZERO_EVENT_SPOOL_MODE=legacy to roll back to synchronous nodes writes.
ZBOARD_ZERO_EVENT_SPOOL_MODE=file
ZBOARD_ZERO_EVENT_SPOOL_HOST_DIR=./zero-events
# Compression supports none, zstd, and lz4. zstd level 1 remains the default.
ZBOARD_ZERO_EVENT_SPOOL_COMPRESSION_ENABLED=true
ZBOARD_ZERO_EVENT_SPOOL_COMPRESSION_ALGORITHM=zstd
ZBOARD_ZERO_EVENT_SPOOL_COMPRESSION_LEVEL=1
ZBOARD_ZERO_EVENT_SPOOL_COMPRESSION_BLOCK_BYTES=2097152
ZBOARD_ZERO_EVENT_SPOOL_COMPRESSION_WORKERS=1
ZBOARD_ZERO_EVENT_SPOOL_MAX_BYTES=5368709120
ZBOARD_ZERO_EVENT_SPOOL_WARNING_RATIO=0.75
ZBOARD_ZERO_EVENT_SPOOL_COMPACT_RATIO=0.85
ZBOARD_ZERO_EVENT_SPOOL_EMERGENCY_RATIO=0.95
ZBOARD_ZERO_EVENT_SPOOL_MIN_FREE_BYTES=536870912
ZBOARD_ZERO_EVENT_SPOOL_EMERGENCY_RESERVE_BYTES=268435456
ZBOARD_ZERO_EVENT_SPOOL_CRITICAL_RESERVE_BYTES=1073741824
# Semantic compaction only replaces cumulative snapshots that are proven safe
# by core_instance_id + sequence. Critical/unknown events are never discarded.
ZBOARD_ZERO_EVENT_SPOOL_COMPACTION_ENABLED=true
ZBOARD_ZERO_EVENT_SPOOL_COMPACTION_FLOW_UPDATES=true
ZBOARD_ZERO_EVENT_SPOOL_COMPACTION_NODE_STATS=true
# Blue/green slots use isolated writers rather than sharing one file queue.
ZBOARD_ZERO_EVENT_SPOOL_BLUE_HOST_DIR=./zero-events-blue
ZBOARD_ZERO_EVENT_SPOOL_GREEN_HOST_DIR=./zero-events-green

# "legacy" is the safe published-kernel contract.
ZBOARD_ZERO_KERNEL_CONTRACT=legacy
ZBOARD_ZERO_LOCAL_VERSION=

# Native-local example (enable only when the exact trusted artifact is present):
# ZBOARD_ZERO_KERNEL_CONTRACT=native-local
# ZBOARD_ZERO_LOCAL_VERSION=0.0.15-rc.1

# Use this only after a reviewed local Zero artifact implements the Mieru
# principal contract. Current public Zero releases do not provide it.
# ZBOARD_ZERO_KERNEL_CONTRACT=native-local-mieru
